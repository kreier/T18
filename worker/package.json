{
  "name": "t18-worker",
  "version": "1.1.3",
  "description": "Cloudflare Worker & D1 backend for flynn0/T18 telemetry",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply t18-mon-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply t18-mon-db --remote",
    "build:docs": "node ../scripts/build-docs.js",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.160.1"
  }
}
